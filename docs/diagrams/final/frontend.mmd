flowchart TB
 subgraph UI_Layer["1. UI Layer (React + Vite + Tailwind)"]
    direction TB
        Pages[("Pages<br>(Dashboard, Calendar, Event,<br>Search, Settings, Import)")]
        Components[("Components<br>(EventModal, CalendarGrid,<br>LocationPicker, Comments)")]
        Hooks[("Custom Hooks<br>(useCalendar, useEvents,<br>useNotifications, useUser)")]
  end
 subgraph EventCases["Event Use Cases"]
        GetEvents["GetEventsUseCase"]
        CreateEvent["CreateEventUseCase"]
        UpdateEvent["UpdateEventUseCase"]
        DeleteEvent["DeleteEventUseCase"]
        SearchEvents["SearchEventsUseCase"]
        AddComment["AddCommentUseCase"]
  end
 subgraph CalCases["Calendar Use Cases"]
        GetCalendars["GetCalendarsUseCase"]
        CreateCalendar["CreateCalendarUseCase"]
        UpdateCalendar["UpdateCalendarUseCase"]
        DeleteCalendar["DeleteCalendarUseCase"]
        SearchCalendars["SearchCalendarsUseCase"]
        AddCalendarComment["AddCalendarCommentUseCase"]
  end
 subgraph UserCases["User Use Cases"]
        GetUserProfile["GetUserProfileUseCase"]
        UpdateUserProfile["UpdateUserProfileUseCase"]
        UpdateNotifications["UpdateNotificationPreferencesUseCase"]
  end
 subgraph IntegrationCases["Integration Use Cases"]
        ImportGoogle["ImportGoogleCalendarUseCase"]
        ImportTeamup["ImportTeamupCalendarUseCase"]
  end
 subgraph S3Cases["S3 Use Cases"]
        UploadImage["UploadImageUseCase"]
  end
 subgraph App_Layer["2. Application Layer (Use Cases)"]
    direction TB
        EventCases
        CalCases
        UserCases
        IntegrationCases
        S3Cases
  end
 subgraph Entities["Entities / Models"]
        ModelEvent["Event Model"]
        ModelCalendar["Calendar Model"]
        ModelUser["User Model"]
        ModelNotification["Notification Model"]
        ModelIntegration["Integration Models"]
  end
 subgraph Interfaces["Repository Interfaces"]
        IEventRepo["IEventRepository<br>(Interface)"]
        ICalRepo["ICalendarRepository<br>(Interface)"]
        IUserRepo["IUserRepository<br>(Interface)"]
        INotifRepo["INotificationRepository<br>(Interface)"]
        IIntegrationRepo["IIntegrationRepository<br>(Interface)"]
        IS3Repo["IS3Repository<br>(Interface)"]
  end
 subgraph Domain_Layer["3. Domain Layer (Core)"]
    direction TB
        Entities
        Interfaces
  end
 subgraph Infra_Layer["4. Infrastructure Layer (API Clients)"]
    direction TB
        HttpEventRepo["HttpEventRepository<br>(Axios implementation)"]
        HttpCalRepo["HttpCalendarRepository<br>(Axios implementation)"]
        HttpUserRepo["HttpUserRepository<br>(Axios implementation)"]
        HttpNotifRepo["HttpNotificationRepository<br>(Axios implementation)"]
        HttpIntegrationRepo["HttpIntegrationRepository<br>(Axios implementation)"]
        HttpS3Repo["HttpS3Repository<br>(Axios implementation)"]
        ApiClient["API Client / Axios Instance<br>(Base URL config)"]
  end
 subgraph subGraph9["Capas de Clean Architecture"]
    direction TB
        UI_Layer
        App_Layer
        Domain_Layer
        Infra_Layer
  end
 subgraph External["External World"]
        Gateway["API Gateway (Puerto 8000)"]
  end

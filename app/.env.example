# ============================================================================
# BASMATI - Variables de Entorno
# ============================================================================
# Copia este archivo como .env y configura tus valores
# cp .env.example .env

# ============================================================================
# BASE DE DATOS
# ============================================================================
# URI de conexión a MongoDB Atlas o local
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
DATABASE_NAME=basmati

# ============================================================================
# SERVICIOS EXTERNOS - APIs
# ============================================================================

# SendGrid - Envío de correos electrónicos
# Obtener en: https://sendgrid.com/
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx

# Dirección de correo remitente (debe estar verificada en SendGrid)
SENDER_EMAIL=amcgil@uma.es

# URL del frontend para enlaces en emails
FRONTEND_URL=http://localhost:5173

# Google Calendar API (opcional)
GOOGLE_CALENDAR_API_KEY=

# TeamUp API (opcional)
TEAMUP_API_KEY=

# ============================================================================
# AWS S3 - Almacenamiento de Imágenes
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=

# ============================================================================
# SERVICIOS (normalmente no necesitas cambiar estos)
# ============================================================================
# Las URLs de los microservicios se configuran automáticamente en docker-compose.yml
# USER_SERVICE_URL=http://user-service:8001
# CALENDAR_SERVICE_URL=http://calendar-service:8002
# etc.


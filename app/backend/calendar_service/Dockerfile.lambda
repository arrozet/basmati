# Dockerfile para AWS Lambda - Calendar Service
FROM public.ecr.aws/lambda/python:3.11

# Copiar requirements
COPY calendar_service/requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r requirements.txt

# Instalar Mangum
RUN pip install --no-cache-dir mangum

# Copiar código del servicio
COPY calendar_service/main.py ${LAMBDA_TASK_ROOT}/
COPY calendar_service/api/ ${LAMBDA_TASK_ROOT}/api/
COPY calendar_service/core/ ${LAMBDA_TASK_ROOT}/core/
COPY calendar_service/models/ ${LAMBDA_TASK_ROOT}/models/
COPY calendar_service/repositories/ ${LAMBDA_TASK_ROOT}/repositories/
COPY calendar_service/schemas/ ${LAMBDA_TASK_ROOT}/schemas/
COPY calendar_service/services/ ${LAMBDA_TASK_ROOT}/services/

# Copiar shared
COPY shared/ ${LAMBDA_TASK_ROOT}/shared/

# Configurar PYTHONPATH para que Python encuentre el módulo shared
ENV PYTHONPATH="${LAMBDA_TASK_ROOT}:${PYTHONPATH}"

# Lambda buscará el handler en main.handler
CMD ["main.handler"]
